# Application
APP_NAME=AgentOS
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL
DATABASE_URL=postgresql://agentos:agentos_dev@localhost:5432/agentos

# Redis
REDIS_URL=redis://localhost:6379/0

# Model provider
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2


# Observability
OTEL_ENABLED=false